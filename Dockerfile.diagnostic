FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends fonts-dejavu-core && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY service/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY diagnostic/ /app/diagnostic/
COPY rendu/paysage/palettes_vegetales.json /app/rendu/paysage/palettes_vegetales.json
COPY service/ /app/service/
# photos de nos réalisations (modèles des produits), publiques sur www.cover.green
RUN python3 /app/service/telecharger_refs.py
WORKDIR /app/service
ENV DIAG_DIR=/app/diagnostic DATA_DIR=/data PYTHONUNBUFFERED=1
CMD exec uvicorn app:app --host 0.0.0.0 --port ${PORT:-8080}
